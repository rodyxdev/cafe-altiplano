# --- Supabase ---------------------------------------------------------------
# URL del proyecto (Settings -> API -> Project URL)
SUPABASE_URL=
# Service role key (Settings -> API -> service_role). NUNCA en el frontend:
# bypassea RLS por completo. Solo se usa desde el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administración ---------------------------------------------------------
ADMIN_USERNAME=
# Hash bcrypt (cost 12) de la contraseña. Generar con: npm run hash -- "la-contrasena"
ADMIN_PASSWORD_HASH=
# Secreto para firmar el JWT de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Operación (opcionales, tienen valor por defecto) -----------------------
# Puerto del servidor
PORT=3000
# development | production. En production la cookie de sesión se marca Secure.
NODE_ENV=development
# true (o 1) cuando el servidor corre detrás de un proxy (Vercel, Nginx) para
# que req.ip use X-Forwarded-For. En local debe quedar en 0.
TRUST_PROXY=0
