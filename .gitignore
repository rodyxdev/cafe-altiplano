# Dependencias
node_modules/

# Variables de entorno
.env
.env.*
# ...pero la plantilla sin secretos sí se versiona
!.env.example

# Archivos sueltos donde suelen acabar las llaves pegadas a mano.
# env.txt (sin punto inicial) NO lo cubria ningun patron anterior.
env.txt
*env*.txt
*.key
secrets*

# Respaldos y temporales
*.bak
*.backup
*~
*.tmp
*.log
npm-debug.log*

# Bases de datos locales
*.sqlite
*.sqlite3
*.sqlite-journal
*.db

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/

# Vercel CLI: vinculación local del proyecto y .env.local con el token OIDC
# (este último ya lo cubren .env y .env.* de arriba).
.vercel
